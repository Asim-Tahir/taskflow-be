{
  "name": "taskflow",
  "version": "1.0.0",
  "description": "Task and Project management system",
  "module": "src/index.ts",
  "type": "module",
  "imports": {
    "#lib/*": {
      "default": "./src/lib/*/index.ts",
      "import": "./src/lib/*/index.ts"
    },
    "#pkg": {
      "default": "./package.json",
      "import": "./package.json"
    },
    "#types": {
      "types": "./src/types/index.d.ts",
      "default": "./src/types/index.d.ts",
      "import": "./src/types/index.d.ts"
    },
    "#env": {
      "default": "./src/constants/env.ts",
      "import": "./src/constants/env.ts"
    },
    "#*": {
      "default": "./src/*/index.ts",
      "import": "./src/*/index.ts"
    },
    "#src/*": {
      "default": "./src/*.ts",
      "import": "./src/*.ts"
    }
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node src/index.ts",
    "dev": "cross-env NODE_ENV=development node --watch src/index.ts",
    "test": "cross-env NODE_ENV=test node --test-global-setup=./tests/setup-tests.ts --test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lowdb": "^7.0.1",
    "swagger-ui-dist": "^5.34.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/swagger-ui-dist": "^3.30.6",
    "cross-env": "^10.1.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^24.10.0"
  }
}
