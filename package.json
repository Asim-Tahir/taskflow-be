{
  "name": "taskflow",
  "version": "1.0.0",
  "description": "Task and Project management system",
  "type": "module",
  "module": "src/index.ts",
  "imports": {
    "#lib/*": "./src/lib/*/index.ts",
    "#pkg": "./package.json",
    "#types": "./src/types/index.d.ts",
    "#env": {
      "workerd": "./src/constants/env/worker.ts",
      "import": "./src/constants/env/node.ts",
      "default": "./src/constants/env/node.ts"
    },
    "#*": "./src/*/index.ts",
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node src/index.ts",
    "dev": "cross-env NODE_ENV=development node --watch src/index.ts",
    "test": "cross-env NODE_ENV=test node --test-global-setup=./tests/setup-tests.ts --test",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node scripts/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "wrangler:types": "wrangler types .wrangler/types/index.d.ts",
    "wrangler:dev": "wrangler dev",
    "wrangler:db:migrate": "wrangler d1 migrations apply",
    "wrangler:deploy": "wrangler deploy",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.5",
    "express": "^5.3.0",
    "lowdb": "^7.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "cross-env": "^10.1.0",
    "drizzle-kit": "1.0.0-rc.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": "^24.22.0"
  }
}
