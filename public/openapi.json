{
  "openapi": "3.2.1",
  "info": {
    "title": "Taskflow API",
    "version": "1.0.0",
    "description": "Task and Project management system"
  },
  "servers": [
    { "url": "/", "name": "v1" }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Check API health",
        "responses": {
          "200": {
            "description": "The API is available.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "data"],
                  "properties": {
                    "success": { "type": "boolean", "enum": [true] },
                    "data": { "type": "null" }
                  }
                },
                "example": { "success": true, "data": null }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "List and filter tasks",
        "description": "Example: /api/v1/tasks?status=pending&priority=high&sort=createdAt&order=desc. page and limit are currently rejected because query values arrive as strings.",
        "parameters": [
          { "name": "title", "in": "query", "schema": { "type": "string", "minLength": 3 } },
          { "name": "description", "in": "query", "schema": { "type": "string", "minLength": 3 } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["pending", "completed"] } },
          { "name": "priority", "in": "query", "schema": { "type": "string", "enum": ["low", "medium", "high"] } },
          { "name": "assignee", "in": "query", "schema": { "type": "string", "minLength": 3 } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["title", "description", "status", "priority", "assignee", "createdAt", "updatedAt"] } },
          { "name": "order", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"], "default": "asc" } },
          { "name": "page", "in": "query", "description": "Currently rejected as a string by query validation.", "schema": { "type": "integer", "minimum": 1, "maximum": 99, "default": 1 } },
          { "name": "limit", "in": "query", "description": "Currently rejected as a string by query validation.", "schema": { "type": "integer", "minimum": 1, "maximum": 99, "default": 10 } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/TaskList" },
          "400": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "post": {
        "tags": ["Tasks"],
        "summary": "Create a task",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TaskCreate" },
              "examples": {
                "createTask": {
                  "summary": "Create a pending task",
                  "value": {
                    "title": "Prepare release notes",
                    "description": "Collect the changes and prepare notes for the next release.",
                    "status": "pending",
                    "priority": "medium"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Task" },
          "400": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/tasks/search": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Search task titles and descriptions",
        "description": "Matches the optional keyword against task titles and descriptions.",
        "parameters": [
          { "name": "keyword", "in": "query", "schema": { "type": "string" } },
          { "$ref": "#/components/parameters/page" },
          { "$ref": "#/components/parameters/limit" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/TaskList" },
          "400": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/tasks/{id}": {
      "parameters": [
        { "$ref": "#/components/parameters/taskId" }
      ],
      "get": {
        "tags": ["Tasks"],
        "summary": "Get a task by ID",
        "responses": {
          "200": { "$ref": "#/components/responses/Task" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "put": {
        "tags": ["Tasks"],
        "summary": "Update a task",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/TaskUpdate" } }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Task" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "patch": {
        "tags": ["Tasks"],
        "summary": "Update selected task fields",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TaskPartialUpdate" },
              "examples": {
                "completeAndAssign": {
                  "summary": "Complete and assign a task",
                  "value": { "status": "completed", "assignee": "jordan-mitchell" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Task" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "delete": {
        "tags": ["Tasks"],
        "summary": "Delete a task",
        "responses": {
          "200": { "$ref": "#/components/responses/Task" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/tasks/assignee/{assignee}": {
      "get": {
        "tags": ["Tasks"],
        "summary": "List tasks assigned to a team member",
        "parameters": [
          { "$ref": "#/components/parameters/assignee" },
          { "$ref": "#/components/parameters/page" },
          { "$ref": "#/components/parameters/limit" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/TaskList" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/tasks/{id}/assign/{assignee}": {
      "patch": {
        "tags": ["Tasks"],
        "summary": "Assign a task to an assignee",
        "parameters": [
          { "$ref": "#/components/parameters/taskId" },
          { "$ref": "#/components/parameters/assignee" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Task" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/reports/summary": {
      "get": {
        "tags": ["Reports"],
        "summary": "Summarize tasks by status, priority, and assignee",
        "responses": {
          "200": {
            "description": "Task counts grouped by status, priority, and assignee.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "total": { "type": "integer" },
                        "breakdown": {
                          "type": "object",
                          "properties": {
                            "status": { "type": "object", "additionalProperties": { "type": "integer" } },
                            "priority": { "type": "object", "additionalProperties": { "type": "integer" } },
                            "assignee": { "type": "object", "additionalProperties": { "type": "integer" } }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/api/v1/reports/{status}": {
      "get": {
        "tags": ["Reports"],
        "summary": "List tasks by status",
        "parameters": [
          {
            "name": "status",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "enum": ["pending", "completed"] }
          },
          { "$ref": "#/components/parameters/page" },
          { "$ref": "#/components/parameters/limit" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/TaskList" },
          "400": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "taskId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "assignee": {
        "name": "assignee",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 3, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
      },
      "page": {
        "name": "page",
        "in": "query",
        "description": "Page number, from 1 to 99. Defaults to 1.",
        "schema": { "type": "integer", "minimum": 1, "maximum": 99, "default": 1 }
      },
      "limit": {
        "name": "limit",
        "in": "query",
        "description": "Page size, from 1 to 99. Defaults to 10.",
        "schema": { "type": "integer", "minimum": 1, "maximum": 99, "default": 10 }
      }
    },
    "schemas": {
      "Task": {
        "type": "object",
        "required": ["id", "title", "status", "priority", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string", "minLength": 3 },
          "description": { "type": "string", "minLength": 16 },
          "status": { "type": "string", "enum": ["pending", "completed"] },
          "priority": { "type": "string", "enum": ["low", "medium", "high"] },
          "assignee": { "type": "string", "minLength": 3, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "TaskCreate": {
        "type": "object",
        "required": ["title", "status", "priority"],
        "properties": {
          "title": { "type": "string", "minLength": 3 },
          "description": { "type": "string", "minLength": 16 },
          "status": { "type": "string", "enum": ["pending"] },
          "priority": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      },
      "TaskUpdate": {
        "type": "object",
        "required": ["title", "status", "priority"],
        "properties": {
          "title": { "type": "string", "minLength": 3 },
          "description": { "type": "string", "minLength": 16 },
          "status": { "type": "string", "enum": ["pending", "completed"] },
          "priority": { "type": "string", "enum": ["low", "medium", "high"] },
          "assignee": { "type": "string", "minLength": 3, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        }
      },
      "TaskPartialUpdate": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "minLength": 3 },
          "description": { "type": "string", "minLength": 16 },
          "status": { "type": "string", "enum": ["pending", "completed"] },
          "priority": { "type": "string", "enum": ["low", "medium", "high"] },
          "assignee": { "type": "string", "minLength": 3, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        }
      },
      "TaskResponse": {
        "type": "object",
        "required": ["success", "data"],
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": { "$ref": "#/components/schemas/Task" },
          "message": { "type": "string" }
        }
      },
      "TaskListResponse": {
        "type": "object",
        "required": ["success", "data", "page", "limit", "total"],
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Task" } },
          "page": { "type": "integer" },
          "limit": { "type": "integer" },
          "total": {
            "type": "integer",
            "description": "Number of stored tasks before filtering for task list, search, and assignee routes; number of tasks in the returned page for reports by status."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["success", "errors"],
        "properties": {
          "success": { "type": "boolean", "enum": [false] },
          "errors": { "type": "array", "items": { "type": "string" } }
        }
      },
      "InternalServerErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string", "enum": ["Internal Server Error"] }
        }
      }
    },
    "responses": {
      "Task": {
        "description": "The task response.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/TaskResponse" },
            "examples": {
              "task": {
                "summary": "A completed task",
                "value": {
                  "success": true,
                  "data": {
                    "id": "7138f7d9-bb6c-4fc3-a631-7a8ba0108784",
                    "title": "Prepare the weekly project update",
                    "status": "completed",
                    "priority": "low",
                    "createdAt": "2026-09-28T08:16:22.742Z"
                  }
                }
              }
            }
          }
        }
      },
      "TaskList": {
        "description": "The task list response.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskListResponse" } } }
      },
      "Error": {
        "description": "The request is invalid or the resource was not found.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "InternalServerError": {
        "description": "An unexpected server error occurred.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/InternalServerErrorResponse" },
            "example": { "error": "Internal Server Error" }
          }
        }
      }
    }
  }
}